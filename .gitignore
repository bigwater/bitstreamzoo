__pycache__/
*.pyc
.venv*/
.vscode/

# Large generated binary test data (regenerated by build.py / generate_tests.py)
# Unit-test .bsdata files (<5MB) are tracked; tier and large data are ignored.
# Regenerate with: python build.py --generate-only --tier small
benchmark/apps/*/datasets/tests/*_tier_small*.bsdata
benchmark/apps/*/datasets/tests/*_small.bsdata
benchmark/apps/*/datasets/tests/*_tier_medium*.bsdata
benchmark/apps/*/datasets/tests/*_medium.bsdata
benchmark/apps/*/datasets/tests/*_tier_large*.bsdata
benchmark/apps/*/datasets/tests/netlist_*_small.bsdata
benchmark/apps/*/datasets/tests/netlist_*_medium.bsdata
benchmark/apps/*/datasets/tests/netlist_*_large.bsdata
benchmark/apps/*/datasets/tests/*_wide_*.bsdata
benchmark/apps/*/datasets/tests/*_large*.bsdata
benchmark/apps/*/datasets/tests/*_gharchive_*.bsdata
benchmark/apps/*/datasets/tests/*_gutenberg_*.bsdata
benchmark/apps/*/datasets/tests/*_ecoli_*.bsdata
benchmark/apps/*/datasets/tests/*_sars_*.bsdata
benchmark/apps/*/datasets/tests/*_hg38_*.bsdata
benchmark/apps/*/datasets/tests/*_mnist_*.bsdata
benchmark/apps/*/datasets/tests/*_cifar*.bsdata
benchmark/apps/bnn/datasets/raw/mnist_data/
benchmark/apps/bnn/datasets/raw/cifar10_data/

# Generated benchmark datasets (regenerated by make_data.py via build.py)
benchmark/apps/*/datasets/medium/
benchmark/apps/*/datasets/large/

# Downloaded raw data files
benchmark/apps/*/datasets/raw/*.gz
benchmark/apps/*/datasets/raw/*.fa
benchmark/apps/*/datasets/raw/*.fasta
benchmark/apps/*/datasets/raw/*.txt
benchmark/apps/*/datasets/raw/*.pcap
!benchmark/apps/*/datasets/raw/readme.md

# C++/CUDA build tree
simulator/csim/build/

# Exceptions: committed unit-correctness fixtures that the patterns
# above would otherwise catch. These are required by the --unit suite
# and stay tracked.
!benchmark/apps/aes_sbox/datasets/tests/aes_sbox_large_1M.bsdata
!benchmark/apps/bitfunnel/datasets/tests/bf_large_n65536.bsdata
!benchmark/apps/bitweaving/datasets/tests/bw_tpc-h_q6_small.bsdata
!benchmark/apps/bitweaving/datasets/tests/bw_wide_100k_tpch_q6.bsdata
!benchmark/apps/bnn/datasets/tests/bnn_mnist_100.bsdata
!benchmark/apps/bnn/datasets/tests/bnn_mnist_10k.bsdata
!benchmark/apps/epistasis/datasets/tests/epistasis_large_1M.bsdata
!benchmark/apps/mison/datasets/tests/mison_large_1m.bsdata
!benchmark/apps/polar/datasets/tests/polar_large_all-zero.bsdata
!benchmark/apps/polar/datasets/tests/polar_large_one-hot_64_msgs_stride-16.bsdata
!benchmark/apps/polar/datasets/tests/polar_large_random_64_msgs_seed42.bsdata
!benchmark/apps/regex/datasets/tests/regex_large_all_zero_payload.bsdata
!benchmark/apps/regex/datasets/tests/regex_large_hand_crafted_mixed_payload.bsdata
!benchmark/apps/regex/datasets/tests/regex_large_random_64bit_10.bsdata
!benchmark/apps/regex/datasets/tests/regex_large_wrccdc2012_10k.bsdata
!benchmark/apps/regex/datasets/tests/regex_large_wrccdc2012_1m.bsdata
