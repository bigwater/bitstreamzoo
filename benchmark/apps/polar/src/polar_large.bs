// Polar code encoding (Arikan 2009), N=1024
// Butterfly XOR network: F^{otimes 10}, 10 stages, 5120 XOR ops

input stream u[1024]
output stream x[1024]

// Copy input to working array
for i in 0..1024 { x[i] = u[i] }

// Stage 0: stride=1, 512 groups of 2
for g in 0..512 {
    int a = g * 2
    int b = a + 1
    x[a] = x[a] ^ x[b]
}

// Stage 1: stride=2, 256 groups of 4
for g in 0..256 {
    int base = g * 4
    for i in 0..2 {
        int a = base + i
        int b = a + 2
        x[a] = x[a] ^ x[b]
    }
}

// Stage 2: stride=4, 128 groups of 8
for g in 0..128 {
    int base = g * 8
    for i in 0..4 {
        int a = base + i
        int b = a + 4
        x[a] = x[a] ^ x[b]
    }
}

// Stage 3: stride=8, 64 groups of 16
for g in 0..64 {
    int base = g * 16
    for i in 0..8 {
        int a = base + i
        int b = a + 8
        x[a] = x[a] ^ x[b]
    }
}

// Stage 4: stride=16, 32 groups of 32
for g in 0..32 {
    int base = g * 32
    for i in 0..16 {
        int a = base + i
        int b = a + 16
        x[a] = x[a] ^ x[b]
    }
}

// Stage 5: stride=32, 16 groups of 64
for g in 0..16 {
    int base = g * 64
    for i in 0..32 {
        int a = base + i
        int b = a + 32
        x[a] = x[a] ^ x[b]
    }
}

// Stage 6: stride=64, 8 groups of 128
for g in 0..8 {
    int base = g * 128
    for i in 0..64 {
        int a = base + i
        int b = a + 64
        x[a] = x[a] ^ x[b]
    }
}

// Stage 7: stride=128, 4 groups of 256
for g in 0..4 {
    int base = g * 256
    for i in 0..128 {
        int a = base + i
        int b = a + 128
        x[a] = x[a] ^ x[b]
    }
}

// Stage 8: stride=256, 2 groups of 512
for g in 0..2 {
    int base = g * 512
    for i in 0..256 {
        int a = base + i
        int b = a + 256
        x[a] = x[a] ^ x[b]
    }
}

// Stage 9: stride=512, 1 group of 1024
x[0] = x[0] ^ x[512]
x[1] = x[1] ^ x[513]
