// Polar code encoding (Arikan 2009), N=64
// Butterfly XOR network: F^{otimes 6}, 6 stages, 192 XOR ops

input stream u[64]
output stream x[64]

// Copy input to working array
for i in 0..64 { x[i] = u[i] }

// Stage 0: stride=1, 32 groups of 2
for g in 0..32 {
    int a = g * 2
    int b = a + 1
    x[a] = x[a] ^ x[b]
}

// Stage 1: stride=2, 16 groups of 4
for g in 0..16 {
    int base = g * 4
    for i in 0..2 {
        int a = base + i
        int b = a + 2
        x[a] = x[a] ^ x[b]
    }
}

// Stage 2: stride=4, 8 groups of 8
for g in 0..8 {
    int base = g * 8
    for i in 0..4 {
        int a = base + i
        int b = a + 4
        x[a] = x[a] ^ x[b]
    }
}

// Stage 3: stride=8, 4 groups of 16
for g in 0..4 {
    int base = g * 16
    for i in 0..8 {
        int a = base + i
        int b = a + 8
        x[a] = x[a] ^ x[b]
    }
}

// Stage 4: stride=16, 2 groups of 32
for g in 0..2 {
    int base = g * 32
    for i in 0..16 {
        int a = base + i
        int b = a + 16
        x[a] = x[a] ^ x[b]
    }
}

// Stage 5: stride=32, 1 group of 64
x[0] = x[0] ^ x[32]
x[1] = x[1] ^ x[33]
x[2] = x[2] ^ x[34]
x[3] = x[3] ^ x[35]
x[4] = x[4] ^ x[36]
x[5] = x[5] ^ x[37]
x[6] = x[6] ^ x[38]
x[7] = x[7] ^ x[39]
x[8] = x[8] ^ x[40]
x[9] = x[9] ^ x[41]
x[10] = x[10] ^ x[42]
x[11] = x[11] ^ x[43]
x[12] = x[12] ^ x[44]
x[13] = x[13] ^ x[45]
x[14] = x[14] ^ x[46]
x[15] = x[15] ^ x[47]
x[16] = x[16] ^ x[48]
x[17] = x[17] ^ x[49]
x[18] = x[18] ^ x[50]
x[19] = x[19] ^ x[51]
x[20] = x[20] ^ x[52]
x[21] = x[21] ^ x[53]
x[22] = x[22] ^ x[54]
x[23] = x[23] ^ x[55]
x[24] = x[24] ^ x[56]
x[25] = x[25] ^ x[57]
x[26] = x[26] ^ x[58]
x[27] = x[27] ^ x[59]
x[28] = x[28] ^ x[60]
x[29] = x[29] ^ x[61]
x[30] = x[30] ^ x[62]
x[31] = x[31] ^ x[63]
